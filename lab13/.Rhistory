library(tidyverse)
library(janitor)
library(naniar)
amniota <- read_csv("data/amniota.csv") %>%
clean_names()
glimpse(amniota)
amniota_clean <- read_csv("data/amniota.csv",
na = c("-999", "NA", "", "not measured")) %>%
clean_names()
amniota_clean <- amniota_clean %>%
mutate(across(where(is.numeric), ~ na_if(.x, -999)))
amniota_clean <- amniota_clean %>%
mutate(across(where(is.numeric), ~ na_if(.x, -999)))
summarize(is.na(amniota_clean))
sum(is.na(amniota_clean))
miss_var_summary(amniota_clean)
summary(amniota_clean)
amniota_clean <- amniota_clean %>%
mutate(egg_mass_g = na_if(egg_mass_g, 0))
amniota_clean %>%
gg_miss_var()
amniota_clean %>%
miss_var_summary()
miss_var_summary(amniota_clean)
amniota_clean %>%
group_by(class) %>%
summarize(n_miss_egg_mass_g = sum(is.na(egg_mass_g))) %>%
arrange(desc(n_miss_egg_mass_g))
library(readr)
surgery <- read_csv("~/Desktop/BIS15L_W2026_Group2/data/Nowacki 2016 Surgery Timing/surgery.csv")
View(surgery)
amniota_clean %>%
gg_miss_var()
View(amniota_clean)
View(amniota)
View(amniota_clean)
