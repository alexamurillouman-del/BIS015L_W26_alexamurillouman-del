knitr::opts_chunk$set(echo = TRUE)
library(tidyverse)
library(janitor)
options(scipen = 999)
gapminder <- read_csv("data/gapminder.csv") %>%
clean_names() %>%
filter(between(year, 1925, 2025))
gapminder %>%
summarize(gapminder)
gapminder %>%
summarize(n_country)
gapminder %>%
summarize(n_countries = n_distinct(country))
gapminder %>%
filter(year %in% c(1925, 2025)) %>%
select(country, year, pop) %>%
pivot_wider(names_from = year, values_from = pop, names_prefix = "pop_") %>%
drop_na(pop_1925, pop_2025) %>%
mutate(pop_growth = pop_2025 - pop_1925) %>%
arrange(desc(pop_growth))
gapminder %>%
filter(country == "China") %>%
ggplot(aes(x = year, y = pop)) +
geom_line() +
geom_point(shape = 22) +
scale_x_continuous(breaks = seq(1925, 2025, 10), minor_breaks = NULL) +
theme(axis.text.x = element_text(angle = 60, hjust = 1)) +
labs(title = "Population Growth Over Time",
x = "Year",
y = "Population")
gapminder %>%
filter(country == "India") %>%
ggplot(aes(x = year, y = pop)) +
geom_line() +
geom_point(shape = 22) +
scale_x_continuous(breaks = seq(1925, 2025, 10), minor_breaks = NULL) +
theme(axis.text.x = element_text(angle = 60, hjust = 1)) +
labs(title = "Population Growth Over Time (India)",
x = "Year",
y = "Population")
gapminder %>%
summarize(
min_lex = min(lex, na.rm = T),
median_lex = median(lex, na.rm = T),
mean_lex = mean(lex, na.rm = T),
max_lex = max(lex, na.rm = T)
)
gapminder %>%
filter(year %in% c(1925, 2025)) %>%
group_by(year) %>%
summarize(
min_lex = min(lex, na.rm = T),
median_lex = median(lex, na.rm = T),
mean_lex = mean(lex, na.rm = T),
max_lex = max(lex, na.rm = T)
)
gapminder %>%
filter(year %in% c(1925, 2025)) %>%
mutate(year = factor(year)) %>%
ggplot(aes(x = lex, fill = year, color = year)) +
geom_density(alpha = 0.6) +
labs(title = "Distribution of Life Expectancy (1925 vs 2025)",
x = "Life Expectancy (years)",
y = NULL,
fill = "Year",
color = "Year")
gapminder %>%
filter(year == 2025, country != "Monaco") %>%
ggplot(aes(x = gdp, y = lex)) +
geom_point(alpha = 0.6) +
geom_smooth(method = "lm", se = FALSE) +
scale_x_log10() +
labs(title = "GDP per Capita vs Life Expectancy (2025)",
x = "GDP per Capita (log scale)",
y = "Life Expectancy (years)")
gapminder %>%
filter(year %in% c(1975, 2025), country != "Monaco") %>%
select(country, year, gdp) %>%
pivot_wider(names_from = year, values_from = gdp) %>%
drop_na(`1975`, `2025`) %>%
mutate(gdp_growth = `2025` - `1975`) %>%
arrange(desc(gdp_growth))
gapminder %>%
filter(between(year, 1975, 2025),
country %in% c("India", "China", "Indonesia", "Pakistan", "USA")) %>%
ggplot(aes(x = year, y = gdp, color = country)) +
geom_line() +
geom_point() +
scale_x_continuous(breaks = seq(1975, 2025, 10), minor_breaks = NULL) +
theme(axis.text.x = element_text(angle = 60, hjust = 1)) +
labs(title = "GDP per Capita Growth (1975–2025)",
x = "Year",
y = "GDP per Capita",
color = "Country")
gapminder %>%
filter(country == "India") %>%
ggplot(aes(x = year, y = pop, colour = "blue")) +
geom_line() +
geom_point(shape = 22) +
scale_x_continuous(breaks = seq(1925, 2025, 10), minor_breaks = NULL) +
theme(axis.text.x = element_text(angle = 60, hjust = 1)) +
labs(title = "Population Growth Over Time (India)",
x = "Year",
y = "Population")
gapminder %>%
filter(country == "India") %>%
ggplot(aes(x = year, y = pop, colour = y="blue")) +
gapminder %>%
filter(country == "India") %>%
ggplot(aes(x = year, y = pop, color = y="blue")) +
gapminder %>%
filter(country == "India") %>%
ggplot(aes(x = year, y = pop, color ="blue")) +
