library("tidyverse")
library("janitor")
#library("naniar")
options(scipen = 999)
fisheries_clean <- read_csv("data/fisheries_clean.csv")
names(fisheries_clean)
fisheries_clean <- fisheries_clean %>%
mutate(period= as.factor(period),
continent= as.factor(continent),
geo_region= as.factor(geo_region),
country= as.factor(country),
scientific_name= as.factor(scientific_name),
common_name= as.factor(common_name),
taxonomic_code= as.factor(taxonomic_code),
status= as.factor(status)) %>%
relocate(period, continent, geo_region, country, scientific_name, common_name, taxonomic_code, status)
View(fisheries_clean)
fisheries_clean %>%
group_by(countries)
fisheries_clean %>%
group_by(country)
fisheries_clean |>
distinct(country)
fisheries_clean %>%
group_by(common_name, taxonomic_code)
fisheries_clean %>%
summarize(across(where(is.numeric),
~mean(.x, na.rm=T)))
fisheries_clean %>%
group_by(common_name, taxonomic_code)
summarize(across(where(is.numeric),
~mean(.x, na.rm=T)))
fisheries_clean %>%
group_by(common_name, taxonomic_code) %>%
summarize(across(where(is.numeric),
~mean(.x, na.rm=T)))
fisheries_clean %>%
filter(catch=="2023") %>%
group_by(country) %>%
fisheries_clean %>%
filter(catch=="2023") %>%
group_by(country) %>%
summarize(across(where(is.numeric),
~mean(.x, na.rm=T)))
fisheries_clean %>%
filter(catch=="2023") %>%
group_by(country) %>%
summarize(mean_country)
fisheries_clean %>%
filter(catch=="2023") %>%
group_by(country) %>%
summarize(mean_country=mean(country,
na.rm=T))
n=n())
fisheries_clean %>%
filter(catch=="2023") %>%
group_by(country) %>%
summarize(mean_country=mean(country,
na.rm=T))
n=n()
fisheries_clean %>%
filter(catch=="2023") %>%
group_by(country) %>%
summarize(catch=sum(country,
na.rm=T))
fisheries_clean %>%
filter(catch=="2023") %>%
group_by(country) %>%
summarize(sum_of_catch)
fisheries_clean %>%
filter(catch=="2023") %>%
group_by(country) %>%
summarize(sum_of_fish)
fisheries_clean %>%
filter(catch=="2023") %>%
group_by(country) %>%
summarize(sum_of_catch)
fisheries_clean %>%
filter(catch=="2023") %>%
group_by(country) %>%
summarize(catch)
fisheries_clean %>%
filter(catch=="2023") %>%
group_by(country) %>%
summarize(total_catch=sum(catch))
fisheries_clean %>%
filter(catch=="2023")
fisheries_clean %>%
filter(period=="2023")
fisheries_clean %>%
filter(period=="2023") %>%
group_by(country) %>%
summarize(total_catch=sum(catch))
fisheries_clean %>%
filter(period=="2023") %>%
group_by(country) %>%
summarize(total_catch=sum(catch)) %>%
arrange(desc(total_catch))
library("tidyverse")
library("janitor")
#library("naniar")
options(scipen = 999)
fisheries_clean <- read_csv("data/fisheries_clean.csv")
names(fisheries_clean)
fisheries_clean <- fisheries_clean %>%
mutate(period= as.factor(period),
continent= as.factor(continent),
geo_region= as.factor(geo_region),
country= as.factor(country),
scientific_name= as.factor(scientific_name),
common_name= as.factor(common_name),
taxonomic_code= as.factor(taxonomic_code),
status= as.factor(status)) %>%
relocate(period, continent, geo_region, country, scientific_name, common_name, taxonomic_code, status)
fisheries_clean |>
distinct(country)
fisheries_clean %>%
group_by(common_name, taxonomic_code) %>%
summarize(across(where(is.numeric),
~mean(.x, na.rm=T)))
fisheries_clean %>%
filter(period=="2023") %>%
group_by(country) %>%
summarize(total_catch=sum(catch)) %>%
arrange(desc(total_catch))
fisheries_clean %>%
summarize(n_countries=n_distinct(country))
fisheries_clean %>%
summarize(common_name, taxonomic_code)
fisheries_clean %>%
summarize(n_common_name= n_distinct(common_name), n_taxonomic_code= n_distinct (taxonomic_code))
fisheries_clean %>%
summarize(common_name= distinct(common_name), taxonomic_code= distinct (taxonomic_code))
fisheries_clean %>%
summarize(n_common_name= n_distinct(common_name), n_taxonomic_code= n_distinct (taxonomic_code))
fisheries_clean %>%
filter(period=="2023") %>%
group_by(common_name) %>%
summarize(total_catch= sum(catch)) %>%
arrange(desc(total_catch))
fisheries_clean %>%
filter(period=="2023", common_name== top_non_nei_species) %>%
group_by(country) %>%
summarize(total_catch=sum(catch)) %>%
arrange(desc(total_catch))
fisheries_clean %>%
filter(period=="2023", common_name== top_non_nei_species) %>%
group_by(country) %>%
summarize(total_catch=sum(catch, na.rm=T)) %>%
arrange(desc(total_catch))
fisheries_clean %>%
filter(period == "2023") %>%
group_by(continent) %>%
summarize(total_catch = sum(catch, na.rm = TRUE)) %>%
arrange(desc(total_catch))
View(fisheries_clean)
fisheries_clean %>%
filter(period=="2023", common_name=="top_non_nei_species") %>%
group_by(country) %>%
summarize(total_catch=sum(catch, na.rm=T)) %>%
arrange(desc(total_catch))
fisheries_clean %>%
filter(period == "2023", common_name == "NEI") %>%
group_by(common_name) %>%
summarize(total_catch = sum(catch, na.rm = T)) %>%
arrange(desc(total_catch))
fisheries_clean %>%
filter(period == "2023", common_name != "NEI") %>%
group_by(common_name) %>%
summarize(total_catch = sum(catch, na.rm = T)) %>%
arrange(desc(total_catch))
fisheries_clean %>%
filter(period == "2023", common_name == "Species_Name") %>%
group_by(country) %>%
summarize(total_catch = sum(catch, na.rm = T)) %>%
arrange(desc(total_catch))
fisheries_clean %>%
filter(period == "2023", common_name == "SPECIES_NAME") %>%
group_by(country) %>%
summarize(total_catch = sum(catch, na.rm = TRUE)) %>%
arrange(desc(total_catch)) %>%
slice(1)
fisheries_clean %>%
filter(period == "2023", common_name == "SPECIES_NAME") %>%
group_by(country) %>%
summarize(total_catch = sum(catch, na.rm = T)) %>%
arrange(desc(total_catch))
fisheries_clean %>%
filter(common_name == "SPECIES_NAME",
period >= 2013,
period <= 2023) %>%
group_by(period) %>%
summarize(total_catch = sum(catch, na.rm = TRUE)) %>%
ggplot(aes(x = period, y = total_catch)) +
geom_point() +
labs(x = "Year", y = "Total Catch",
title = "Total Catch by Year (2013–2023)")
fisheries_clean %>%
filter(common_name == "SPECIES_NAME",
period >= 2013,
period <= 2023) %>%
group_by(period) %>%
summarize(total_catch = sum(catch, na.rm = TRUE)) %>%
ggplot(aes(x = period, y = total_catch)) +
geom_point() +
labs(x = "Year", y = "Total Catch", title = "Total Catch by Year (2013–2023)")
