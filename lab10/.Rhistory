library("tidyverse")
library("janitor")
life_history <- read_csv("data/mammal_lifehistories_v2.csv", na="-999") %>%
clean_names()
life_history %>%
geom_bar(aes(x=number, y=mammals))
View(life_history)
life_history %>%
ggplot(aes(x=order))+
geom_bar()+
coord_flip()
life_history %>%
ggplot(aes(x=order, fill=order))+
geom_bar()+
coord_flip()
life_history %>%
ggplot(aes(x=order, fill=order))+
geom_col()+
coord_flip()
life_history %>%
ggplot(aes(x=order, fill=order))+
geom_col()
life_history %>%
count(order, sort=T)
life_history %>%
count(order, sort=T)
ggplot(aes(x=order, y=n))+
geom_col()+
coord_flip()
