library(tidyverse)
library(janitor)
library(palmerpenguins)
options(scipen=999) #cancels the use of scientific notation for the session
homerange <- read_csv("data/Tamburelloetal_HomeRangeDatabase.csv", na = c("", "NA", "\\")) %>% clean_names()
View(homerange)
homerange <- read_csv("data/Tamburelloetal_HomeRangeDatabase.csv",
na = c("", "NA", "\\")) %>%
clean_names()
View(homerange)
p <- homerange %>%
ggplot(aes(x=log10_mass, y=log10_hra))
p+geom_point(size=2.25)
p+geom_point(size=3)
p+geom_point(size=5)
p+geom_point(size=1)
p+geom_point(size=1.99)
p+geom_point(size=3)
p+geom_point(size=2.5)
p+geom_point(size=2.25)
p+geom_point(aes(color=thermoregulation, size=1))
p+geom_point(aes(color=thermoregulation), size=1)
p+geom_point(aes(color=thermoregulation), size=2)
p+geom_point(aes(shape=thermoregulation, color=thermoregulation), size=2)
p+geom_point(aes(size=3, color="blue", alpha=0.8, shape=24, fill="green"
p+geom_point(aes(size=3, color="blue", alpha=0.8, shape=24, fill="green")
p+geom_point(size=3, color="blue", alpha=0.8, shape=24, fill="green")
colors()
p+geom_point(size=3, color="blue", alpha=0.8, shape=24, fill="deepskyblue")
p+geom_point(size=3, color="blue", alpha=0.8, shape=24, fill="turquoise1")
# Plot all available point shapes
df <- data.frame(x = 1:25, y = rep(1, 25), shape = 0:24)
ggplot(df, aes(x, y)) +
geom_point(aes(shape = factor(shape)), size = 5, fill = "lightblue") +
scale_shape_manual(values = 0:24) +
theme_void() +
theme(legend.position = "none") +
geom_text(aes(label = shape), vjust = -1, size = 5)
p+geom_point(size=3, color="blue", alpha=0.8, shape=23, fill="turquoise1")
