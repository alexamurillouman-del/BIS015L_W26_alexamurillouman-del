output$plot <- renderPlot({
elephants %>%
filter(!is.na(sex), sex != "NA") %>%
ggplot(aes_string(x="sex", y=input$y, fill="sex")) +
geom_boxplot(alpha=0.75, color="turquoise4") +
labs(title="Elephants Range by Sex",
x="Sex", y=input$y, fill="Sex") +
theme_minimal()
})
}
