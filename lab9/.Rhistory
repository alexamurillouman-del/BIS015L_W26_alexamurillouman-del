pivot_longer(
exp1_rep1:exp3_rep3,
names_to = c("experiment", "replicate"),
names_sep = "_",
values_to = "mRNA expression"
)
View(qpcr_untidy)
qpcr_tidy <- qpcr_untidy %>%
pivot_longer(
exp1_rep1:exp3_rep3,
names_to = c("experiment", "replicate"),
names_sep = "_",
values_to = "mRNA expression"
)
qpcr_tidy
qpcr_tidy %>%
seperate(experiment, into=c("experiment, e_number"), sep=3)
qpcr_tidy %>%
separate(experiment, into=c("experiment, e_number"), sep=3)
qpcr_tidy %>%
separate(experiment, into=c("experiment", "e_number"), sep=3) %>%
separate(replicate, into=c("rep", "r_number"), sep=3) %>%
select(gene, experiment=e_number, replicate=r_number, `mRNA expression`)
